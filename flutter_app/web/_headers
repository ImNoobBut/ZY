/*
  Cloudflare Pages headers — long cache for hashed Flutter assets;
  no-cache for SW/manifest so updates propagate.
*/
/flutter_service_worker.js
  Cache-Control: no-cache

/sw-assets.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
